{
  "expo": {
    "name": "calorie-cam-app",
    "slug": "calorie-cam-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.raphproudhon.caloriecam"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "CalorieCam lit votre dépense énergétique (calories actives et de repos) pour l'ajuster à vos apports et affiner votre objectif quotidien.",
          "NSHealthUpdateUsageDescription": "CalorieCam n'écrit aucune donnée dans Santé pour le moment.",
          "background": false
        }
      ]
    ]
  }
}
